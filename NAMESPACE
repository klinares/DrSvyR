# Written by hand, not generated by roxygen.
#
# roxygen would mean adding an @export tag above 216 functions to change the
#   visibility of one of them, and a diff that size hides whatever else is in
#   it. This file is nine lines and says the same thing.

# One export. Everything else stays internal: the modules, the engine, the
#   estimation. They are still visible to each other inside the package
#   namespace, so nothing about how the code is written has to change, and the
#   package's public surface is one function rather than fifty mod_*_server
#   names that would then have to stay stable.
export(run_drsvyr)

# Whole-package imports for the ones the code calls bare throughout. This is
#   what makes the conversion possible without touching the source: filter(),
#   map(), aes() and the rest keep working exactly as they do under library().
import(dplyr)
import(ggplot2)
import(purrr)
import(shiny)
import(stringr)
import(tibble)
import(tidyr)

# Named imports for the rest, because these are called in a handful of places
#   and a whole-package import would drag in collisions for no benefit.
# survey attaches Matrix, whose expand(), pack() and unpack() collide with
#   tidyr's; importing only what is used avoids having to arbitrate that.
importFrom(survey, svydesign)
importFrom(survey, as.svrepdesign)
importFrom(survey, svymean)
importFrom(survey, svyby)
importFrom(survey, degf)
importFrom(survey, SE)

importFrom(haven, read_sav)
importFrom(haven, read_dta)
importFrom(haven, write_sav)
importFrom(haven, write_dta)
importFrom(haven, as_factor)
importFrom(haven, labelled)

importFrom(furrr, future_map)
importFrom(furrr, furrr_options)

importFrom(knitr, kable)

# scale_colour_viridis_d() and scale_fill_viridis_d() are ggplot2 exports, not
#   viridis ones -- viridis supplies the palettes, ggplot2 supplies the scales
#   that use them. They were listed here as viridis imports and the package
#   would not install: importFrom() resolves at load time and fails hard on a
#   name the namespace does not have. They are already covered by
#   import(ggplot2) above.
# viridis() itself is the one thing genuinely taken from viridis, for the
#   manual palette in plots.R.
importFrom(viridis, viridis)

# bslib was missing altogether. page_fluid(), bs_theme() and input_dark_mode()
#   are called bare in app_ui(), and unlike the case above this would not have
#   surfaced at install -- function bodies are not evaluated then -- but at
#   runtime, the moment the UI was built.
importFrom(bslib, page_fluid)
importFrom(bslib, bs_theme)
importFrom(bslib, input_dark_mode)

# stats::filter and stats::lag are masked by dplyr under library() too, so the
#   code already means the dplyr ones. Named here so the intent is recorded
#   rather than left to import order.
importFrom(stats, median, quantile, qt, p.adjust, reformulate, sd, complete.cases)
importFrom(stats, coef, pt, runif, update, weights, xtabs)
importFrom(utils, combn, head, tail, packageVersion, installed.packages)

# R CMD check also suggested importFrom("stats", "AIC", "BIC") and
#   importFrom("utils", "example"). Not taken, and deliberately: AIC and BIC
#   are columns built in search_sizes() (model.R) and read by plot_bic();
#   example is a column in the nonresponse-code clash table (data.R). The
#   check cannot tell a masked column name from a function it happens to
#   match, and importing the functions would silence the note by asserting
#   something false. They are declared as globals instead.
